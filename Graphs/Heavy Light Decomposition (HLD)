/*
    Heavy-Light Decomposition (HLD)
    Used to decompose tree paths into O(log n) contiguous array ranges.

    Supports:
    - Point updates
    - Path sum queries
    - Subtree sum queries

    Build: O(n)
    Point Update: O(log n)
    Path Query: O(log^2 n)
    Subtree Query: O(log n)
*/

class HLD {
public:
    int n, timer;
    vector<vector<int>> adj;
    vector<int> parent, depth, sz, heavy, head, pos;
    vector<int> base;
    SegmentTree_Sum seg;

    HLD(int n) : n(n), timer(0), adj(n), parent(n), depth(n),
                 sz(n), heavy(n, -1), head(n), pos(n),
                 base(n), seg(n) {}

    // Add an undirected edge
    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // DFS 1: Compute subtree sizes and heavy children
    // Time Complexity: O(n)
    void dfs(int v, int p) {
        parent[v] = p;
        sz[v] = 1;
        int mx = 0;
        for (int u : adj[v]) {
            if (u == p) continue;
            depth[u] = depth[v] + 1;
            dfs(u, v);
            sz[v] += sz[u];
            if (sz[u] > mx) {
                mx = sz[u];
                heavy[v] = u;
            }
        }
    }

    // DFS 2: Assign chain heads and flattened positions
    // Time Complexity: O(n)
    void decompose(int v, int h, const vector<int> &values) {
        head[v] = h;
        pos[v] = timer++;
        base[pos[v]] = values[v];

        if (heavy[v] != -1) {
            decompose(heavy[v], h, values);
        }

        for (int u : adj[v]) {
            if (u == parent[v] || u == heavy[v]) continue;
            decompose(u, u, values);
        }
    }

    // Build HLD and the underlying segment tree
    // Time Complexity: O(n)
    void build(const vector<int> &values, int root = 0) {
        timer = 0;
        depth[root] = 0;
        dfs(root, -1);
        decompose(root, root, values);
        seg.build(base, 1, 0, n - 1);
    }

    // Assign a new value to node v
    // Time Complexity: O(log n)
    void update(int v, int value) {
        seg.updateRange(1, 0, n - 1, pos[v], pos[v], value - base[pos[v]]);
        base[pos[v]] = value;
    }

    // Query sum of values on path u -> v
    // Time Complexity: O(log^2 n)
    int queryPath(int u, int v) {
        int ans = 0;
        while (head[u] != head[v]) {
            if (depth[head[u]] < depth[head[v]]) {
                swap(u, v);
            }
            ans += seg.query(1, 0, n - 1, pos[head[u]], pos[u]);
            u = parent[head[u]];
        }

        if (depth[u] > depth[v]) {
            swap(u, v);
        }

        ans += seg.query(1, 0, n - 1, pos[u], pos[v]);
        return ans;
    }

    // Query sum of values in subtree of v
    // Time Complexity: O(log n)
    int querySubtree(int v) {
        return seg.query(1, 0, n - 1, pos[v], pos[v] + sz[v] - 1);
    }
};
