int base = 31;
int mod = 1e9 + 7;

int rabinKarp(string s, string p) {
    int n = s.size(), m = p.size();

    if (m > n) return -1;

    int ph = 0, sh = 0, pw = 1;

    for (int i = 0; i < m; i++) {
        ph = (ph * base + (p[i] - 'a' + 1)) % mod;
        sh = (sh * base + (s[i] - 'a' + 1)) % mod;

        if (i < m - 1)
            pw = pw * base % mod;
    }

    for (int i = 0; i <= n - m; i++) {
        if (ph == sh) {
            bool ok = true;
            for (int j = 0; j < m; j++) {
                if (s[i + j] != p[j]) {
                    ok = false;
                    break;
                }
            }
            if (ok) return i;
        }

        if (i + m < n) {
            sh = (sh - (s[i] - 'a' + 1) * pw % mod + mod) % mod;
            sh = (sh * base + (s[i + m] - 'a' + 1)) % mod;
        }
    }

    return -1;
}
