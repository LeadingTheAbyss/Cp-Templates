// Fast Fourier Transform (FFT): Used for fast polynomial multiplication in O(nlogn)
using db = double;
using cd = complex<db>;
template<class T>
class FFT {
public:
    // FFT transform
    static void fft (vector<cd>& a, bool invert) {
        int n = a.size();
        for (int i = 1, j = 0; i < n; i++) {
            int bit = n >> 1;
            for (; j & bit; bit >>= 1) {
                j ^= bit;
            }
            j ^= bit;
            if (i < j) {
                swap(a[i], a[j]);
            }
        }

        for (int len = 2; len <= n; len <<= 1) {
            db angle = 2 * acos(-1.0) / len * (invert ? -1 : 1);
            cd wlen(cos(angle), sin(angle));

            for (int i = 0; i < n; i += len) {
                cd w(1);
                for (int j = 0; j < len / 2; j++) {
                    cd u = a[i + j];
                    cd v = a[i + j + len / 2] * w;
                    a[i + j] = u + v;
                    a[i + j + len / 2] = u - v;
                    w *= wlen;
                }
            }
        }

        if (invert) {
            for (cd &x : a) {
                x /= n;
            }
        }
    }

    /* 
        Polynomial multiplication (convolution)
        FFT<ll>::convolve(a, b);
        Multiply two polynomials represented by coefficient arrays.
        Example: convolve({1, 1}, {1, 1}); 
        Multiplies two polynomials: (1 + x) * (1 + x) = 1 + 2x + x²
    */
    static vector<T> convolve (const vector<T>& a, const vector<T>& b) {
        if (a.empty() or b.empty()) {
            return {};
        }
        vector<cd> fa(a.begin(), a.end());
        vector<cd> fb(b.begin(), b.end());
        int n = 1;
        while (n < (int)a.size() + (int)b.size() - 1) {
            n <<= 1;
        }
        fa.resize(n);
        fb.resize(n);
        fft(fa, false);
        fft(fb, false);

        for(int i = 0; i < n; i++) {
            fa[i] *= fb[i];
        }

        fft(fa, true);
        vector<T> res(n);
        for(int i = 0; i < n; i++) {
            res[i] = (T)round(fa[i].real());
        }

        res.resize(a.size() + b.size() - 1);
        return res;
    }

    /* 
        Polynomial exponentiation using binary exponentiation
        FFT<ll>::power(a, k);
        Raise polynomial a to power k using binary exponentiation.
        Nonzero coefficients are converted to 1 after each multiplication.
    */
    static vector<T> power (vector<T> poly, int exp) {
        vector<T> res(1, 1);
        while (exp > 0) {
            if (exp & 1) {
                res = convolve(res, poly);
                for (auto &c : res) {
                    c = (c != 0);
                }
            }
            exp >>= 1;
            if (exp) {
                poly = convolve(poly, poly);
                for (auto &c : poly) {
                    c = (c != 0);
                }
            }
        }
        return res;
    }
};
